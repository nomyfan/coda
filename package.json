{
  "name": "coda",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "node -e \"if(!process.env.CI)require('child_process').execSync('pnpm exec prek install',{stdio:'inherit'})\"",
    "build:linux": "node scripts/build-linux.mts",
    "build:linux:arm64": "node scripts/build-linux.mts --arch arm64",
    "build:linux:x64": "node scripts/build-linux.mts --arch x64",
    "typecheck": "tsc --noEmit",
    "test": "pnpm -r run test",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check ."
  },
  "dependencies": {
    "commander": "^14.0.2"
  },
  "devDependencies": {
    "@j178/prek": "^0.4.4",
    "@types/node": "catalog:",
    "oxfmt": "^0.54.0",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.5.0"
}
